{
  "GET /api/config": {
    "shape": {
      "backend": "str",
      "instruction": "str",
      "judge": {
        "face_models": "bool",
        "hand_models": "bool",
        "mode": "str"
      },
      "max_attempts": "int",
      "negative": "str",
      "prep": {
        "enabled": "bool",
        "mode": "str",
        "parse_model": "bool"
      },
      "sampling": {
        "cfg": "float",
        "resolution": "int",
        "sampler": "str",
        "scheduler": "str",
        "steps": "int"
      }
    },
    "status": 200,
    "type": "json"
  },
  "GET /api/export 无参": {
    "shape": {
      "error": "str"
    },
    "status": 400,
    "type": "json"
  },
  "GET /api/export?job=": {
    "shape": {
      "error": "str"
    },
    "status": 404,
    "type": "json"
  },
  "GET /api/history": {
    "shape": [
      {
        "cases": "int",
        "cost": "float",
        "elapsed_s": "float",
        "garments": [
          "str"
        ],
        "id": "str",
        "passed": "int",
        "ts": "str"
      }
    ],
    "status": 200,
    "type": "json"
  },
  "GET /api/job/<id>": {
    "shape": {
      "cases": [
        {
          "attempts": [
            {
              "attempt": "int",
              "case": "int",
              "error": "null",
              "error_kind": "str",
              "garment": "str",
              "ok": "bool",
              "stage": "str",
              "ts": "str"
            }
          ],
          "attempts_used": "int",
          "final_image": "null",
          "final_url": "null",
          "first_attempt_passed": "bool",
          "garment": "str",
          "index": "int",
          "instruction_used": "str",
          "passed": "bool",
          "state": "str",
          "verdict": "null"
        }
      ],
      "elapsed_s": "int",
      "error": "null",
      "id": "str",
      "judge_mode": "str",
      "metrics": {
        "avg_attempts": "float",
        "avg_generate_s": "float",
        "cases": "int",
        "failure_reasons": {},
        "final_pass_rate": "float",
        "first_pass_rate": "float",
        "judge_mode": "str",
        "total_generate_s": "int"
      },
      "person": "str",
      "person_url": "str",
      "replayed": "bool",
      "state": "str"
    },
    "status": 200,
    "type": "json"
  },
  "GET /api/job/不存在": {
    "shape": {
      "error": "str"
    },
    "status": 404,
    "type": "json"
  },
  "GET /api/jobs": {
    "shape": [
      {
        "cases": "int",
        "elapsed_s": "float",
        "id": "str",
        "state": "str"
      }
    ],
    "status": 200,
    "type": "json"
  },
  "GET /api/metrics": {
    "shape": {
      "avg_attempts": "float",
      "cases": "int",
      "cost_currency": "str",
      "final_pass_rate": "float",
      "first_pass_rate": "float",
      "jobs": "int",
      "total_cost": "float"
    },
    "status": 200,
    "type": "json"
  },
  "GET /img?path=": {
    "shape": "binary",
    "status": 200,
    "type": "image/png"
  },
  "GET /static/js/main.js": {
    "shape": "binary",
    "status": 200,
    "type": "text/javascript"
  },
  "GET /不存在": {
    "shape": {
      "error": "str"
    },
    "status": 404,
    "type": "json"
  },
  "POST /api/config 空": {
    "shape": {
      "ok": "bool"
    },
    "status": 200,
    "type": "json"
  },
  "POST /api/run 空": {
    "shape": {
      "error": "str"
    },
    "status": 400,
    "type": "json"
  },
  "POST /api/upload": {
    "shape": {
      "file": "str",
      "from_format": "str",
      "note": "str",
      "ok": "bool",
      "path": "str",
      "rotated": "bool",
      "size": "int",
      "url": "str"
    },
    "status": 200,
    "type": "json"
  }
}